# C++26 breaks Apple SDK headers when compiling Objective-C++ (ColorSync
# enum arithmetic). Upstream targets modern C++ without requiring latest.
#
cxx.std = c++20

using cxx
using cxx.objcxx

# Upstream uses .h public/private headers and .cpp sources. Embedded shaders
# are .bin.h (header-only inclusion). IDL fragment is .idl.inl.
#
hxx{*}: extension = h
ixx{*}: extension = ipp
txx{*}: extension = tpp
cxx{*}: extension = cpp

# Required when including libbx public headers under MSVC.
#
if ($cxx.target.system == 'win32-msvc')
  cxx.coptions += /Zc:preprocessor

# BX_CONFIG_DEBUG comes from libbx export. Backend selection is fixed in the
# source buildfile for the initial Vulkan + Noop package.

test.target = $cxx.target
