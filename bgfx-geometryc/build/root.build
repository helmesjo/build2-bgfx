# Uncomment to suppress warnings coming from external libraries.
#
#cxx.internal.scope = current

cxx.std = latest

using cxx

hxx{*}: extension = h
ixx{*}: extension = ipp
txx{*}: extension = tpp
cxx{*}: extension = cpp

# Required when including libbx public headers under MSVC.
#
if ($cxx.target.system == 'win32-msvc')
  cxx.coptions += /Zc:preprocessor

# Structure padding from bx alignment specifiers is accepted upstream (it
# builds with /wd4324).
#
if ($cxx.class == 'msvc')
  cxx.coptions += /wd4324

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target
