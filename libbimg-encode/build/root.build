cxx.std = latest

using cxx

hxx{*}: extension = h
ixx{*}: extension = ipp
txx{*}: extension = tpp
cxx{*}: extension = cpp

# Required when including libbx public headers under MSVC.
# /wd4828: vendored nvtt (and similar) sources contain non-UTF-8 bytes.
#
if ($cxx.target.system == 'win32-msvc')
  cxx.coptions += /Zc:preprocessor /wd4828

# Propagate BX_CONFIG_DEBUG via libbx (through libbimg). No extra package
# config for v1.

test.target = $cxx.target
