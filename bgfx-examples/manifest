: 1
name: bgfx-examples
version: 1.153.9149-a.0.z
language: c++
project: bgfx
summary: Interactive examples for the bgfx rendering library
license: BSD-2-Clause
description-file: README.md
package-description-file: PACKAGE-README.md
url: https://github.com/bkaradzic/bgfx
email: packaging@build2.org
doc-url: https://bkaradzic.github.io/bgfx/examples.html
src-url: https://github.com/bkaradzic/bgfx
package-url: https://github.com/build2-packaging/bgfx
package-email: packaging@build2.org
depends: * build2 >= 0.18.0
depends: * bpkg >= 0.18.0
depends: libbgfx == $
depends: libiconfontcppheaders >= 2026.6.5-
depends: libtinystl ^0.0.1-
depends: libimgui ^1.92.3
depends: libimguizmo ^1.10.0-

# entry_x11 needs X11 development packages. Drop bare Linux bots and use
# named sys configurations that install them (CI uses --sys-no-stub:
# libx11 -> libx11-dev, libX11 -> libX11-devel on Fedora).
#
builds: -linux

debian-builds: sys
debian-builds: -static
debian-builds: -bindist
debian-build-include: linux_debian*-**
debian-build-include: linux_ubuntu*-**
debian-build-exclude: **
debian-build-config:
\
sys:libx11
\

fedora-builds: sys
fedora-builds: -static
fedora-builds: -bindist
fedora-build-include: linux_fedora*-**
fedora-build-exclude: **
fedora-build-config:
\
sys:libX11
\
