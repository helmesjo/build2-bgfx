# Auto-include non-example dirs (common/, etc.). Numbered example dirs are
# excluded from the wildcard and added explicitly. shaders/, textures/, and
# meshes/ are large runtime fixtures, not build scopes.
#
./: {*/ -build/ -shaders/ -textures/ -meshes/ -[0-9]*-*/} \
  00-helloworld/ \
  doc{README.md PACKAGE-README.md} legal{LICENSE} manifest

# common/ is a private utility library, not installed as a product.
#
common/: install = false

# Prebuilt runtime assets. install does not affect dist.
#
shaders/: install = false
textures/: install = false
meshes/: install = false

# Large git-only fixtures. include = false keeps the unpacked dist archive
# from trying to update files that were never copied. dist = false is
# target-specific (own declaration) so collect() actually drops them.
#
./: file{shaders/** textures/** meshes/**}:
{
  include = false
}

file{shaders/** textures/** meshes/**}:
{
  dist = false
}

# Extra examples: git-only. Every numbered dir except 00-helloworld (already
# unconditionally included above), pattern-enumerated so nothing needs to be
# listed by name. Prerequisite-specific include, not an if around the
# declaration (that is a dist warning, not an exclusion).
#
./: {[0-9]*-*/ -00-helloworld/}:
{
  include = ($build.meta_operation != 'dist')
}

# Every example except 00-helloworld needs shaders/ (some also textures/ and
# meshes/), all install = false above, so an installed exe could never find
# its own assets. Type/pattern-specific, not enumerated: reaches the exe{}
# built inside each matching dir/. -pattern exclusion is only performed in
# enumerated prerequisite lists, not here, so override 00-helloworld back
# explicitly.
#
dir{[0-9]*-*}: install = false
00-helloworld/: install = true
