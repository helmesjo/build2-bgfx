intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

import intf_libs += libbx%lib{bx}
import impl_libs += libbimg%lib{bimg}
import impl_libs += libvulkan-headers%lib{vulkan-headers}

# RenderDoc in-application API (debug_renderdoc.cpp on Windows/Linux).
# Runtime dlopen of renderdoc.dll / librenderdoc.so. Header only, do not
# link lib{renderdoc}.
#
import impl_libs += librenderdoc-app%lib{renderdoc-app}

# Private bgfx_p.h includes <tinystl/...>.
#
import impl_libs += libtinystl%lib{tinystl}

# Metal backend (macOS) uses the packaged metal-cpp multi-header layout via a
# path shim under 3rdparty/metal-cpp/ (bgfx includes <metal-cpp/metal.hpp>).
#
if ($cxx.target.class == 'macos')
  import impl_libs += libmetal-cpp%lib{metal-cpp}

# D3D11/D3D12 backends (Windows) rely on libdirectx-headers for the D3D12 and
# D3DX12 headers. D3D11 and DXGI headers come from the Windows SDK (MSVC) or
# MinGW-w64. D3D runtimes are dlopen'd at runtime; no import libs are linked.
#
if ($cxx.target.class == 'windows')
  import impl_libs += libdirectx-headers%liba{directx-headers}

# Vulkan is loaded at runtime via dlopen (libMoltenVK.dylib / libvulkan.so.1 /
# vulkan-1.dll). Headers come from the libvulkan-headers dependency.

# Public headers.
#
pub = [dir_path] ../include/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

# Automatic DLL symbol exporting (bdep new auto-symexport pattern).
#
lib{bgfx}: libul{bgfx}: $pub/{$pub_hdrs}

# Implementation sources. Exclude amalgamated TU. Platform backends that are
# disabled via BGFX_CONFIG_* still compile to empty TUs (ifdef guards).
#
# On macOS, renderer_vk.cpp is compiled as renderer_vk.mm (Objective-C++ for
# Cocoa/Metal surface interop). Elsewhere the plain .cpp is used.
#
libul{bgfx}: {hxx cxx}{** -amalgamated -renderer_vk -3rdparty/** -h264/**} \
             mm{renderer_vk} $impl_libs $intf_libs: \
               include = ($cxx.target.class == 'macos')
libul{bgfx}: {hxx cxx}{** -amalgamated -3rdparty/** -h264/**} \
             $impl_libs $intf_libs: \
               include = ($cxx.target.class != 'macos')

# Embedded shader binaries and shader sources are included from C++ headers.
#
libul{bgfx}: file{**.bin.h}: include = adhoc
libul{bgfx}: file{**.sc}: include = adhoc
libul{bgfx}: file{**.sh}: include = adhoc
libul{bgfx}: file{**.idl.inl}: include = adhoc

# RenderDoc and metal-cpp path shims (not installed).
#
libul{bgfx}: 3rdparty/renderdoc/hxx{renderdoc_app}: include = adhoc
libul{bgfx}: 3rdparty/metal-cpp/file{**}: include = adhoc

# Wicked Engine H.264 parser, vendored as a single header. Not a standalone
# package. The src/ include path makes #include <h264/h264.h> work.
#
h264/libul{WickedEngine-h264}: h{h264/*} legal{h264/LICENSE.txt}
libul{bgfx}: h264/libul{WickedEngine-h264}

libs{bgfx}: def{bgfx}: include = ($cxx.target.system == 'win32-msvc')
def{bgfx}: libul{bgfx}

# Build options.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

# $src_pfx_src is the parent of h264/ so sources can #include <h264/h264.h>.
# $src_pfx_src/3rdparty is for the RenderDoc and metal-cpp path shims
# (<renderdoc/renderdoc_app.h>, <metal-cpp/metal.hpp>).
#
cxx.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
                "-I$out_pfx_inc" "-I$src_pfx_inc" \
                "-I$src_pfx_src/3rdparty"

# Desktop backends: Vulkan everywhere, Metal on Apple, D3D11+D3D12 on Windows.
# Defining any BGFX_CONFIG_RENDERER_* skips the platform-default block in config.h.
#
d3d   = ($cxx.target.class == 'windows' ? 1 : 0)
metal = ($cxx.target.class == 'macos'   ? 1 : 0)

cxx.poptions += \
  -DBGFX_CONFIG_RENDERER_VULKAN=1 \
  "-DBGFX_CONFIG_RENDERER_DIRECT3D11=$d3d" \
  "-DBGFX_CONFIG_RENDERER_DIRECT3D12=$d3d" \
  "-DBGFX_CONFIG_RENDERER_METAL=$metal" \
  -DBGFX_CONFIG_RENDERER_OPENGL=0 \
  -DBGFX_CONFIG_RENDERER_OPENGLES=0 \
  -DBGFX_CONFIG_RENDERER_WEBGPU=0 \
  -DBGFX_CONFIG_RENDERER_GNM=0 \
  -DBGFX_CONFIG_RENDERER_AGC=0 \
  -DBGFX_CONFIG_RENDERER_NVN=0 \
  -DBGFX_CONFIG_VIDEO=0

# Platform system libraries (not importable targets: use *.libs).
# Vulkan is dlopen'd at runtime. pthread/dl come from libbx export.
#
if ($cxx.target.class == 'macos')
{
  # Cocoa/Metal/IOKit: Metal backend and MoltenVK surface interop.
  #
  sys_libs = \
    -framework Cocoa \
    -framework Metal \
    -framework MetalKit \
    -framework QuartzCore \
    -framework IOKit
}
elif ($cxx.target.class == 'windows')
{
  if ($cxx.target.system == 'mingw32')
    sys_libs = -luser32 -lgdi32
  else
    sys_libs = user32.lib gdi32.lib
}
else
  sys_libs = [null]

if ($cxx.target.system == 'mingw32')
  cxx.loptions += -Wl,--export-all-symbols

# Export options. libbx is an interface dependency (AllocatorI, embedded
# shader helpers). Export platform libs for shared-library consumers.
#
lib{bgfx}:
{
  cxx.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc"
  cxx.export.libs = $intf_libs
}

if ($sys_libs != [null])
{
  cxx.libs += $sys_libs
  lib{bgfx}: cxx.export.libs += $sys_libs
}

if $version.pre_release
  lib{bgfx}: bin.lib.version = "-$version.project_id"
else
  lib{bgfx}: bin.lib.version = "-$version.major.$version.minor"

# Don't install private headers.
#
{hxx ixx txx}{*}: install = false
