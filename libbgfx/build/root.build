# Apple SDK headers use enum arithmetic that C++26 makes ill-formed.
#
using cxx.guess
cxx.std = ($cxx.target.class == 'macos' ? 20 : latest)

using c
using cxx
using cxx.objcxx

# Upstream uses .h public/private headers and .cpp sources. Embedded shaders
# are .bin.h (header-only inclusion). IDL fragment is .idl.inl.
#
hxx{*}: extension = h
ixx{*}: extension = ipp
txx{*}: extension = tpp
cxx{*}: extension = cpp

# Upstream compile-time configuration (src/config.h). Each variable sets the
# BGFX_CONFIG_* macro of the same name and defaults to the upstream value.
# Renderer backends are selected in the source buildfile. BGFX_CONFIG_DEBUG
# follows BX_CONFIG_DEBUG from the libbx export (config.libbx.debug).
#
config [bool] config.libbgfx.profiler                             ?= false
config [bool] config.libbgfx.multithreaded                        ?= true
config [bool] config.libbgfx.encoder_api_only                     ?= false
config [bool] config.libbgfx.prefer_discrete_gpu                  ?= ($cxx.target.class == 'windows')
config [bool] config.libbgfx.renderer_vulkan_robust_buffer_access ?= false

config [uint64] config.libbgfx.max_draw_calls             ?= 65535
config [uint64] config.libbgfx.max_blit_items             ?= 1024
config [uint64] config.libbgfx.max_views                  ?= 256
config [uint64] config.libbgfx.max_vertex_layouts         ?= 64
config [uint64] config.libbgfx.max_index_buffers          ?= 4096
config [uint64] config.libbgfx.max_vertex_buffers         ?= 4096
config [uint64] config.libbgfx.max_dynamic_index_buffers  ?= 4096
config [uint64] config.libbgfx.max_dynamic_vertex_buffers ?= 4096
config [uint64] config.libbgfx.max_shaders                ?= 512
config [uint64] config.libbgfx.max_textures               ?= 4096
config [uint64] config.libbgfx.max_frame_buffers          ?= 128
config [uint64] config.libbgfx.max_uniforms               ?= 512
config [uint64] config.libbgfx.max_occlusion_queries      ?= 256

test.target = $cxx.target
