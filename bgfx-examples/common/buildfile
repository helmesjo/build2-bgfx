# Link static archives. libbx/libbimg/libbgfx use auto-symexport for shared
# builds (best-effort), but Windows auto-import does not cover global data.
# Public bx inlines (e.g. toSeconds) reference Ticks::s_kInvFreq, which fails
# to resolve against the shared import library on MSVC.
#
intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

import intf_libs += libbgfx%liba{bgfx}
import intf_libs += libbimg%liba{bimg}
import intf_libs += libbx%liba{bx}

# Header-only icon codepoints. Public stub imgui.h includes the headers.
#
import intf_libs += libiconfontcppheaders%lib{iconfontcppheaders}

# Header-only mini-STL. bgfx_utils.h includes <tinystl/...>.
#
import intf_libs += libtinystl%lib{tinystl}

# Overlay public header includes <imgui.h>. Static, same as liba{bgfx}.
#
import intf_libs += libimgui%liba{imgui}

# Overlay public header includes <imguizmo/ImGuizmo.h>. Static, same as imgui.
#
import intf_libs += libimguizmo%liba{imguizmo}

# loadTexture / imageLoad. Private to example-load-program.
#
import impl_libs += libbimg-decode%liba{bimg-decode}

# Mesh::load / weldVertices decode path. Private to example-load-program.
#
import impl_libs += libmeshoptimizer%lib{meshoptimizer}

platform_entry =
if ($cxx.target.class == 'macos')
  platform_entry = mm{entry/entry_osx entry/dialog_darwin}
elif ($cxx.target.class == 'windows')
  platform_entry = cxx{entry/entry_windows}
else
  platform_entry = cxx{entry/entry_x11}

# Shared example glue (entry + overlay). Overlay draws through libimgui.
#
./: libue{example-common}

# bgfx_utils (loadProgram, mesh/texture loading) for monorepo extras that
# use shaders/, textures/, and meshes/ (not distributed). Prerequisite-
# specific include, not an if around the declaration.
#
./: libue{example-load-program}:
{
  include = ($build.meta_operation != 'dist')
}

# POSIX separators so the string literal is valid on Windows (no \U, \h, ...).
#
shaders_dir = $path.posix_string($src_root/shaders)
runtime_dir = $path.posix_string($src_root)

libue{example-load-program}: cxx{bgfx_utils} $impl_libs $intf_libs
{
  # meshoptimizer/src/meshoptimizer.h shim: bgfx sources include the path
  # bgfx's own vendored copy uses; libmeshoptimizer exports <meshoptimizer.h>
  # unqualified (upstream v1.2 layout).
  #
  cxx.poptions =+ \
    "-I$out_base" "-I$src_base" \
    "-I$src_base/3rdparty" \
    "-DBGFX_EXAMPLES_SHADERS_DIR=\"$shaders_dir\"" \
    "-DBGFX_EXAMPLES_RUNTIME_DIR=\"$runtime_dir\""
}

libue{example-load-program}: hxx{common bgfx_utils}: include = adhoc
libue{example-load-program}: entry/hxx{**}: include = adhoc

# Source-tree runtime data. Tracked, not compiled.
#
libue{example-load-program}: ../shaders/file{**}:
{
  include = adhoc
}

libue{example-load-program}: ../textures/file{**}:
{
  include = adhoc
}

libue{example-load-program}: ../meshes/file{**}:
{
  include = adhoc
}

# First-party debug draw (embedded shaders). Only 29-debugdraw links this.
#
libue{example-debugdraw}: cxx{debugdraw/debugdraw} $impl_libs $intf_libs
{
  cxx.poptions =+ "-I$out_base" "-I$src_base"
}

libue{example-debugdraw}: debugdraw/file{**.bin.h}: include = adhoc
libue{example-debugdraw}: debugdraw/hxx{*}: include = adhoc

debugdraw/{hxx cxx file}{*}:
{
  dist = false
}

libue{example-common}: \
  cxx{example-glue camera} \
  cxx{entry/entry entry/cmd entry/input entry/dialog} \
  $platform_entry \
  cxx{imgui/imgui imgui/widgets/widgets} \
  $impl_libs $intf_libs

libue{example-common}:
{
  cxx.poptions =+ \
    "-I$out_base" "-I$src_base" \
    -DENTRY_CONFIG_IMPLEMENT_MAIN=1 \
    -DUSE_ENTRY=1 \
    -DUSE_LOCAL_STB=0

  cxx.export.libs = $intf_libs
}

libue{example-common}: imgui/file{**.bin.h **.ttf.h **.inl}: include = adhoc
libue{example-common}: entry/hxx{**} imgui/hxx{**}: include = adhoc
libue{example-common}: hxx{common args bgfx_utils camera packrect}: include = adhoc

if ($cxx.target.class == 'macos')
{
  libue{example-common}: cxx.libs += \
    -framework Cocoa \
    -framework QuartzCore \
    -framework Metal \
    -framework IOKit
}
elif ($cxx.target.class == 'windows')
{
  if ($cxx.target.system == 'mingw32')
    libue{example-common}: cxx.libs += -luser32 -lgdi32 -lshell32 -lcomdlg32 -lxinput
  else
    libue{example-common}: cxx.libs += user32.lib gdi32.lib shell32.lib comdlg32.lib xinput.lib
}
else
  libue{example-common}: cxx.libs += -lX11
