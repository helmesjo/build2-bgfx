# Apple SDK headers use enum arithmetic that C++26 makes ill-formed.
#
using cxx.guess
cxx.std = ($cxx.target.class == 'macos' ? 20 : latest)

using cxx
using cxx.objcxx

# 42-bunnylod/progmesh.c is plain C, called from bunnylod.cpp via extern "C".
#
using c

hxx{*}: extension = h
ixx{*}: extension = ipp
txx{*}: extension = tpp
cxx{*}: extension = cpp

# Required when including libbx public headers under MSVC.
#
if ($cxx.target.system == 'win32-msvc')
  cc.coptions += /Zc:preprocessor

test.target = $cxx.target
