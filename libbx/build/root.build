# Upstream bx uses .h / .inl public headers and .cpp sources.
#
cxx.std = latest

using cxx

hxx{*}: extension = h
ixx{*}: extension = ipp
txx{*}: extension = tpp
cxx{*}: extension = cpp

# BX_CONFIG_DEBUG is required by public headers. Default false (release).
#
config [bool] config.libbx.debug ?= false

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target
