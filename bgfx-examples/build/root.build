# Match libbgfx: C++20 avoids Apple SDK + C++26 Objective-C++ issues.
#
cxx.std = c++20

using cxx
using cxx.objcxx

hxx{*}: extension = h
ixx{*}: extension = ipp
txx{*}: extension = tpp
cxx{*}: extension = cpp

# Suppress warnings from third-party dear-imgui / example glue.
#
cxx.internal.scope = current

test.target = $cxx.target
