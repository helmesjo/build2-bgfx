intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

import intf_libs += libbimg%lib{bimg}
import impl_libs += libastcenc%lib{astcenc} \
                    libsquish%lib{squish} \
                    libetcpak%lib{etcpak} \
                    stb_image_resize2%lib{stb_image_resize2} \
                    libiqa%lib{iqa}

# Public headers.
#
pub = [dir_path] ../include/bimg/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

# Automatic DLL symbol exporting (bdep new auto-symexport pattern).
#
lib{bimg-encode}: libul{bimg-encode}: $pub/{$pub_hdrs}

# Encode implementation, private headers, and leftover encoder third-parties
# (matches upstream bimg_encode sources). edtaa3 lives beside this buildfile
# as file-level symlinks, not a 3rdparty dir mount.
#
libul{bimg-encode}: {hxx cxx}{** -3rdparty/** -edtaa3/**} \
                    3rdparty/etc1/{hxx cxx}{**} \
                    3rdparty/pvrtc/{hxx cxx}{**} \
                    $impl_libs $intf_libs

# Euclidean distance transform (SDF). Not a standalone package. The src/
# include path makes #include <edtaa3/edtaa3func.h> work.
#
edtaa3/libul{edtaa3}: {hxx cxx}{edtaa3/*} legal{edtaa3/LICENSE.md}
libul{bimg-encode}: edtaa3/libul{edtaa3}

libs{bimg-encode}: def{bimg-encode}: include = ($cxx.target.system == 'win32-msvc')
def{bimg-encode}: libul{bimg-encode}

# Build options.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

# $src_pfx_src is the parent of edtaa3/ so sources can
# #include <edtaa3/edtaa3func.h>. 3rdparty root matches upstream
# bimg_encode includedirs for the remaining vendors.
#
cxx.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
                "-I$out_pfx_inc" "-I$src_pfx_inc" \
                "-I$src_pfx_src/3rdparty"

if ($cxx.target.system == 'mingw32')
  cxx.loptions += -Wl,--export-all-symbols

# Upstream Genie relaxes several warnings on the encode third-parties.
#
if ($cxx.class != 'msvc')
{
  cxx.coptions += -Wno-implicit-fallthrough -Wno-shadow \
                  -Wno-shift-negative-value -Wno-undef \
                  -Wno-deprecated-copy
}

# Export options.
#
lib{bimg-encode}:
{
  cxx.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc" \
                        "-I$out_pfx_inc/bimg" "-I$src_pfx_inc/bimg"
  cxx.export.libs = $intf_libs
  cxx.pkgconfig.include = include/ include/bimg/
}

if $version.pre_release
  lib{bimg-encode}: bin.lib.version = "-$version.project_id"
else
  lib{bimg-encode}: bin.lib.version = "-$version.major.$version.minor"

# Don't install private headers.
#
{hxx ixx txx}{*}: install = false
