# Apple SDK headers use enum arithmetic that C++26 makes ill-formed.
#
using cxx.guess
cxx.std = ($cxx.target.class == 'macos' ? 20 : latest)

using cxx
using cxx.objcxx

# 42-bunnylod/progmesh.c is plain C, called from bunnylod.cpp via extern "C".
#
using c

hxx{*}: extension = h
ixx{*}: extension = ipp
txx{*}: extension = tpp
cxx{*}: extension = cpp

# Required when including libbx public headers under MSVC.
#
if ($cxx.class == 'msvc')
  cc.coptions += /Zc:preprocessor

# Warnings upstream accepts: nameless structs and unions, structure padding
# from alignment specifiers (upstream builds with /wd4201 /wd4324), and the
# CRT functions it calls on purpose (upstream defines _CRT_SECURE_NO_WARNINGS).
#
if ($cxx.class == 'msvc')
  cc.coptions += /wd4201 /wd4324

if ($cxx.target.system == 'win32-msvc')
  cc.poptions += -D_CRT_SECURE_NO_WARNINGS

test.target = $cxx.target
